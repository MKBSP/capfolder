{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Capfolder",
  "version": "0.1.0",
  "identifier": "com.capfolder.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Capfolder",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https: http://localhost:8787 http://127.0.0.1:8787"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyMEU0OEZFM0E3RjY4NkYKUldSdmFIODYva2dPc2hrMVJ2Tm9pZnB1UUkxM2dHdUlCQXRGUTZNQityL0RGL05MWDNkdy9VRWkK",
      "endpoints": ["https://github.com/MKBSP/capfolder/releases/latest/download/latest.json"]
    }
  }
}
