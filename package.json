{
  "name": "capfolder",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "licenses:gen": "node scripts/check-licenses.mjs --write",
    "licenses:check": "node scripts/check-licenses.mjs",
    "dev:desktop": "pnpm --filter @capfolder/desktop tauri dev",
    "build:desktop": "pnpm --filter @capfolder/desktop tauri build",
    "rules:sign": "node apps/desktop/scripts/rules.mjs sign",
    "dev:web": "pnpm --filter @capfolder/website dev",
    "help:check": "node scripts/help-check.mjs",
    "shots": "node scripts/shots.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.5",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "overrides": {
      "jsdom": "26.1.0"
    }
  }
}
