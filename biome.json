{
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!fixtures",
      "!design",
      "!brand",
      "!docs",
      "!**/src/ocf/schemas-*.json",
      "!**/public/ocr",
      "!rules",
      "!**/src-tauri/target",
      "!**/src-tauri/gen",
      "!**/dist"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["DateInput"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/desktop/src/styles/app.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    }
  ]
}
