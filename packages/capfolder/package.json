{
  "name": "capfolder",
  "version": "0.1.2",
  "description": "Run your Capfolder cap table from Claude and other AI assistants.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "capfolder": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js --external:@modelcontextprotocol/sdk --external:zod --external:pdfjs-dist --banner:js=\"#!/usr/bin/env node\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "build:mcpb": "sh mcpb/build.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "pdfjs-dist": "6.3.289",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capfolder/core": "workspace:*",
    "@capfolder/vault": "workspace:*",
    "esbuild": "0.28.2",
    "pdf-lib": "1.17.1"
  }
}
