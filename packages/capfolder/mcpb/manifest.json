{
  "manifest_version": "0.3",
  "name": "capfolder",
  "display_name": "Capfolder",
  "version": "0.1.1",
  "description": "Run your cap table from Claude: set it up, ask about it, change it with your yes.",
  "author": { "name": "Capfolder", "url": "https://capfolder.com" },
  "homepage": "https://capfolder.com",
  "license": "AGPL-3.0-only",
  "server": {
    "type": "node",
    "entry_point": "dist/cli.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/cli.js", "mcp"]
    }
  },
  "compatibility": { "runtimes": { "node": ">=22.0.0" } }
}
